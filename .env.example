# 复制为 .env 或直接在服务器上 export（推荐用 PM2 的 ecosystem.config.js 配 env）
# 必填：Agnes API Key
AGNES_API_KEY=sk-在这里填你的Key

# 可选：接口地址，默认就是下面这个
AGNES_BASE_URL=https://apihub.agnes-ai.com

# 可选：监听端口，默认 3077
PORT=3077

# 可选：设为 1 则「必须登录才能调用生图/生视频接口」，防止公网盗用 Key
# 本地开发不设置即可；服务器部署强烈建议设为 1
REQUIRE_LOGIN=1

# 可选：token 签名密钥。不设置则自动生成并存入 .session_secret
# 多实例部署时，所有实例必须配置成同一个值，否则登录态会互相失效
# SESSION_SECRET=一串足够长的随机字符串
