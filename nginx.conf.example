# Nginx 反向代理配置示例
# 用法：复制为 /etc/nginx/conf.d/aigc.conf，替换 your-domain.com，然后 nginx -t && nginx -s reload

# HTTP → HTTPS 跳转
server {
    listen 80;
    server_name your-domain.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name your-domain.com;

    # SSL 证书（用 certbot 免费申请：certbot --nginx -d your-domain.com）
    ssl_certificate     /etc/letsencrypt/live/your-domain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your-domain.com/privkey.pem;

    # 图生图/图生视频会上传参考图，放宽请求体大小
    client_max_body_size 20m;

    # 关键：生图/建视频任务可能耗时 1-2 分钟，超时必须调大，否则会出现 504
    proxy_connect_timeout 30s;
    proxy_send_timeout    300s;
    proxy_read_timeout    300s;

    location / {
        proxy_pass http://127.0.0.1:3077;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 可选：仅内网/白名单访问（自用强烈建议）
    # allow 1.2.3.4;      # 你的 IP
    # deny  all;

    # 可选：Basic Auth 口令保护（自用强烈建议，见 README）
    # auth_basic "AIGC Studio";
    # auth_basic_user_file /etc/nginx/.aigc_htpasswd;
}
